{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "21 Viewer",
  "version": "0.1.0",
  "identifier": "ai.21.viewer",
  "build": {
    "beforeBuildCommand": "bash tauri/prepare-dist.sh",
    "beforeDevCommand": "bash tauri/prepare-dist.sh",
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "21 Viewer",
        "width": 900,
        "height": 1100,
        "minWidth": 620,
        "minHeight": 440,
        "decorations": false,
        "url": "scribe-ui/basic-viewer/tauri.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF document",
        "description": "PDF document",
        "mimeType": "application/pdf",
        "role": "Viewer"
      },
      {
        "ext": ["scribe"],
        "name": "Scribe document",
        "description": "Scribe OCR document",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "cli": {
      "args": [
        { "name": "path", "index": 1, "takesValue": true },
        { "name": "file", "takesValue": true, "short": "f" },
        { "name": "action", "takesValue": true, "short": "a" },
        { "name": "page", "takesValue": true, "short": "p" },
        { "name": "highlights", "takesValue": true, "short": "H" }
      ]
    }
  }
}
